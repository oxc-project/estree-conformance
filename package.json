{
  "name": "estree-conformance",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Boshen",
  "type": "module",
  "main": "index.mjs",
  "scripts": {
    "init": "pnpm run '/^clone-*/'",
    "clone-test262": "just clone-submodule submodules/test262 https://github.com/tc39/test262.git 7ab7fafa0003f73fc85c1b95d88094d33f7eb8bd",
    "clone-acorn-jsx": "just clone-submodule submodules/acorn-jsx https://github.com/acornjs/acorn-jsx.git 8ed96d6ddec2065204ba07d924bb2e7bca539ea6",
    "clone-typescript": "just clone-submodule submodules/typescript https://github.com/microsoft/TypeScript.git 50d70a3f5f453a79a4323b263165da51f656a4e3",
    "start": "pnpm run gen-test262 && pnpm run gen-acorn-jsx && pnpm run gen-typescript",
    "gen-test262": "node src/test262.ts",
    "gen-acorn-jsx": "node src/acorn-jsx.ts",
    "gen-typescript": "node src/typescript-eslint.ts",
    "lint": "vp lint src",
    "fmt": "vp fmt",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@typescript-eslint/parser": "^8.70.1",
    "acorn": "^8.18.0",
    "espree": "^11.2.0",
    "estree-walker": "^3.0.3",
    "meriyah": "^7.3.3",
    "vite-plus": "latest",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.28.0"
}
